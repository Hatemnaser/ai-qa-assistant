# Read-only deployment smoke configuration. The API URL must be an HTTPS
# origin without credentials, path, query, or fragment. HTTP is accepted only
# for localhost/loopback development targets.
ODDPATH_SMOKE_BASE_URL=https://api-staging.example.com
# Required for authenticated mutation smoke; recommended for read-only CORS checks.
ODDPATH_SMOKE_WEB_ORIGIN=https://web-staging.example.com
ODDPATH_SMOKE_TIMEOUT_MS=10000
# Must match the API's CSRF_HEADER_NAME when that server setting is customized.
ODDPATH_SMOKE_CSRF_HEADER_NAME=X-CSRF-Token

# The authenticated-mutation command additionally requires a dedicated,
# verified test account. Put real values only in a local ignored env file or
# CI/host secret manager; never commit them or pass the password as a CLI arg.
ODDPATH_SMOKE_EMAIL=smoke-operator@example.com
ODDPATH_SMOKE_PASSWORD=replace-in-secret-manager
ODDPATH_SMOKE_MUTATION_CONFIRMATION=CREATE_AND_DELETE_ODDPATH_SMOKE_PROJECT
