# Add self-hosted.alerts.compose.yml last; --profile alerts up -d alerts.
# Existing base/operations/optional stack interpolation values still required.
# No provider is provisioned, no email sent and no paid service enabled by this file.
ODDPATH_ALERT_STATE_VOLUME=oddpath-alerts-state
# FULL_SYSTEM: use the full-backup-state volume, NEVER the DB-only backup-state.
ODDPATH_ALERT_BACKUP_STATE_VOLUME=oddpath-full-backup-state
ODDPATH_ALERT_CONFIG_FILE=/etc/oddpath/alerts.json
ODDPATH_ALERT_SMTP_PASSWORD_FILE=/etc/oddpath/alert-smtp-password
# Provision NEW state volume mode0700 UID0; source state stays its native owner.
# Both host secret files mode0600 readable by UID0, not in Git. No API/PG/vault keys.
# JSON content for alerts.json (copy privately, remove comment prefixes):
# {
#   "schemaVersion": 1,
#   "instance": "oddpath-staging",
#   "maintenanceState": "/observe/maintenance/status.json",
#   "backupState": "/observe/backup/status.json",
#   "backupScope": "FULL_SYSTEM",
#   "assets": true,
#   "apiReadyUrl": "http://api:5000/api/health/ready",
#   "smtp": {
#     "host": "smtp-relay.brevo.com",
#     "port": 587,
#     "user": "operator-smtp-login",
#     "passwordFile": "/run/secrets/alert_smtp_password",
#     "from": "ops@example.invalid",
#     "to": "operator@example.invalid"
#   }
# }
# `assets` MUST match the maintenance manifest (all R2 credentials => true),
# even with uploads disabled. backupScope MUST match the selected supervisor.
# Config is operator-controlled; HTTP readiness URL only on trusted private
# network; public readiness must use HTTPS. Redirects are refused. Never accept
# monitor URLs from users, expose state directories, or add a Docker socket.
# Authenticated STARTTLS is REQUIRED; no plaintext/skip-verification toggle.
# `node ops/alerts.mjs test` explicitly sends a TEST message: operator must confirm
# inbox receipt. SMTP_ACCEPTED alone is not delivery proof. No automatic test mail.
# Poll15s; failure/new affected checks => notice; repeat6h while unresolved;
# recovery notice only after all configured checks pass. Durable SMTP retries
# 1/2/4/8/15min; same Message-ID per pending notice. SMTP ambiguity can duplicate
# a message; exactly-once delivery is not promised. State persists across restart.
# At most8 AUTOMATIC send attempts per rolling hour, including rejected/ambiguous
# sends. Flapping/restarts share this durable cap; excess notices remain pending
# and health stays failed until confirmed. Explicit operator TEST is outside it.
# Config identity changes fail closed with existing state: drain old notices or
# explicitly provision NEW private notifier state after operator review. Never
# delete/reset source backup/maintenance state. Removing a check is not recovery.
# Docker health fails on stale/no scan, unresolved incident or unconfirmed mail;
# unhealthy does NOT itself restart Docker or alert outside this host.
# Before launch separately prove external host-death monitoring, live email
# delivery, off-host backup, and actual scheduler/browser reaper coverage.
