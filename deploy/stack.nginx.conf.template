# One trusted HTTP hop. Clients cannot choose upstreams or forwarded identity.
# No request/access logs: viewer tickets and user data must not enter ingress logs.
resolver 127.0.0.11 valid=5s ipv6=off;
map $http_upgrade $oddpath_upgrade { default close; websocket upgrade; }
ssl_certificate /run/secrets/ingress_tls_chain;
ssl_certificate_key /run/secrets/ingress_tls_key;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_session_tickets off;
server_tokens off;
access_log off;
client_max_body_size 25m;

server {
    listen 8443 ssl default_server;
    server_name _;
    return 444;
}
server {
    listen 8443 ssl;
    server_name ${ODDPATH_APP_HOST};
    root /usr/share/nginx/html;
    include /etc/nginx/oddpath-security-headers.conf;
    location = /healthz { return 200 'ok'; }
    location = /_headers { return 404; }
    location = /security-headers.conf { return 404; }
    location /api/ { return 404; }
    location / { try_files $uri $uri/ /index.html; }
}
server {
    listen 8443 ssl;
    server_name ${ODDPATH_API_HOST};
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    location / {
        set $api_backend http://api:5000;
        proxy_pass $api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header Forwarded "";
        proxy_set_header Connection "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 90s;
    }
}
server {
    listen 8443 ssl;
    server_name ${ODDPATH_VIEWER_HOST};
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    location / {
        set $viewer_backend http://browser-supervisor:8081;
        proxy_pass $viewer_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Forwarded "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $oddpath_upgrade;
        proxy_connect_timeout 3s;
        # Match the existing maximum 15-minute viewer/runtime authority.
        # The gateway's live-grant guard still closes expired/Stopped streams.
        proxy_read_timeout 900s;
        proxy_buffering off;
        proxy_intercept_errors on;
        error_page 502 503 504 =503 @viewer_unavailable;
    }
    location @viewer_unavailable { return 503 'Browser unavailable'; }
}
