# Standard static frontend + HTTPS ingress. Origins are immutable build inputs.
ARG ODDPATH_NGINX_IMAGE
FROM node:24-bookworm-slim AS build
WORKDIR /opt/oddpath
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/qa-execution-contract/package.json packages/qa-execution-contract/package.json
RUN npm ci --ignore-scripts --workspace=@ai-qa-assistant/web --workspace=@oddpath/qa-execution-contract --include-workspace-root
COPY packages/qa-execution-contract packages/qa-execution-contract
COPY apps/web apps/web
ARG VITE_API_BASE_URL
ARG VITE_BROWSER_VIEWER_ORIGIN
ARG VITE_R2_ENDPOINT=""
RUN npm --prefix packages/qa-execution-contract run build && npm --prefix apps/web run build \
    && node -e "const f=require('fs');f.writeFileSync('/opt/oddpath/ingress-hosts',[new URL(process.env.VITE_API_BASE_URL).hostname,new URL(process.env.VITE_BROWSER_VIEWER_ORIGIN).hostname,''].join(String.fromCharCode(10)))"

# Supply a reviewed digest for a release; the build has no default mutable tag.
FROM ${ODDPATH_NGINX_IMAGE} AS runtime
RUN test "$(id -u nginx)" = 101 && test "$(id -g nginx)" = 101 \
    && rm -f /etc/nginx/conf.d/default.conf \
    && sed -i -E 's@^[[:space:]]*pid[[:space:]]+[^;]+;@pid /tmp/nginx.pid;@' /etc/nginx/nginx.conf \
    && grep -q 'pid /tmp/nginx.pid;' /etc/nginx/nginx.conf
COPY --from=build /opt/oddpath/apps/web/dist /usr/share/nginx/html
COPY --from=build /opt/oddpath/apps/web/dist/security-headers.conf /etc/nginx/oddpath-security-headers.conf
COPY deploy/stack.nginx.conf.template /etc/nginx/templates/oddpath.conf.template
COPY --from=build /opt/oddpath/ingress-hosts /etc/nginx/oddpath-build-hosts
COPY --chmod=0555 deploy/15-oddpath-hosts.sh /docker-entrypoint.d/15-oddpath-hosts.sh
RUN sed -i 's/\r$//' /docker-entrypoint.d/15-oddpath-hosts.sh
ENV NGINX_ENVSUBST_FILTER="^ODDPATH_(APP_HOST|API_HOST|VIEWER_HOST)$"
USER nginx:nginx
EXPOSE 8443
