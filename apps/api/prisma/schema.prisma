generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

enum MemoryScope {
  USER
  PROJECT
  CHAT
}

enum MemorySource {
  USER_PROVIDED
  AI_EXTRACTED
  CHAT_SUMMARY
  IMPORTED
}

enum ProjectDocumentSource {
  USER_PROVIDED
  IMPORTED
}

enum ProjectDocumentIndexStatus {
  PENDING
  READY
  FAILED
}

enum ProjectDocumentEmbeddingStatus {
  PENDING
  READY
  FAILED
}

enum StoredAssetPurpose {
  CHAT_ATTACHMENT
  PROJECT_DOCUMENT_SOURCE
}

enum StoredAssetStatus {
  PENDING
  VALIDATING
  READY
  FAILED
  DELETE_PENDING
}

enum AuthEmailKind {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum AuthEmailJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String?
  passwordHash         String?
  locale               String    @default("en")
  emailVerifiedAt      DateTime?
  acceptedTermsVersion String?
  acceptedTermsAt      DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  sessions                   Session[]
  settings                   UserSettings?
  ownedProjects              Project[]                   @relation("ProjectOwner")
  projectMemberships         ProjectMember[]
  chats                      Chat[]
  conversationSummaries      ConversationSummary[]
  memories                   Memory[]
  aiUsageLogs                AiUsageLog[]
  usageEvents                UsageEvent[]
  passwordResetTokens        PasswordResetToken[]
  emailVerificationTokens    EmailVerificationToken[]
  authEmailJobs              AuthEmailJob[]
  storedAssets               StoredAsset[]
  binaryAssetRestoreSessions BinaryAssetRestoreSession[]

  @@index([emailVerifiedAt, createdAt, id])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailJob AuthEmailJob?

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([usedAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailJob AuthEmailJob?

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([usedAt])
}

model AuthEmailJob {
  id                       String             @id
  userId                   String
  kind                     AuthEmailKind
  status                   AuthEmailJobStatus @default(PENDING)
  encryptedPayload         String?
  emailVerificationTokenId String?            @unique
  passwordResetTokenId     String?            @unique
  attempts                 Int                @default(0)
  nextAttemptAt            DateTime           @default(now())
  lockedAt                 DateTime?
  sentAt                   DateTime?
  expiresAt                DateTime
  lastErrorCode            String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailVerificationToken EmailVerificationToken? @relation(fields: [emailVerificationTokenId], references: [id], onDelete: Cascade)
  passwordResetToken     PasswordResetToken?     @relation(fields: [passwordResetTokenId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([status, expiresAt])
  @@index([status, updatedAt])
  @@index([userId, kind, status])
  @@index([lockedAt])
}

model UserSettings {
  id            String   @id @default(cuid())
  userId        String   @unique
  language      String   @default("en")
  theme         String   @default("system")
  defaultModel  String   @default("gemini-3.1-flash-lite")
  aiPreferences Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner         User                @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members       ProjectMember[]
  chats         Chat[]
  memories      Memory[]
  documents     ProjectDocument[]
  instruction   ProjectInstruction?
  projectMemory ProjectMemory?
  storedAssets  StoredAsset[]

  @@index([ownerId])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Chat {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  title     String   @default("New QA Chat")
  mode      String   @default("general")
  model     String   @default("gemini-2.5-flash")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  project             Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages            Message[]
  conversationSummary ConversationSummary?
  memories            Memory[]
  aiUsageLogs         AiUsageLog[]

  @@index([userId, updatedAt])
  @@index([projectId, updatedAt])
}

model Message {
  id         String   @id @default(cuid())
  chatId     String
  role       ChatRole
  content    String
  mode       String   @default("general")
  model      String?
  attachment Json?
  metadata   Json?
  createdAt  DateTime @default(now())

  chat        Chat                @relation(fields: [chatId], references: [id], onDelete: Cascade)
  aiUsageLogs AiUsageLog[]
  attachments MessageAttachment[]

  @@index([chatId, createdAt])
}

model ConversationSummary {
  id               String   @id @default(cuid())
  chatId           String   @unique
  userId           String
  summary          String
  throughMessageId String?
  openQuestions    String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model Memory {
  id         String       @id @default(cuid())
  userId     String?
  projectId  String?
  chatId     String?
  scope      MemoryScope
  content    String
  source     MemorySource @default(USER_PROVIDED)
  confidence Float        @default(0.8)
  metadata   Json?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chat    Chat?    @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([userId, scope])
  @@index([projectId, scope])
  @@index([chatId, scope])
}

model ProjectDocument {
  id              String                     @id @default(cuid())
  projectId       String
  title           String
  content         String
  source          ProjectDocumentSource      @default(USER_PROVIDED)
  mimeType        String?
  metadata        Json?
  contentHash     String                     @default("")
  chunkingVersion String                     @default("")
  indexStatus     ProjectDocumentIndexStatus @default(PENDING)
  indexError      String?
  indexedAt       DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  sourceAssetId   String?                    @unique

  project     Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chunks      ProjectDocumentChunk[]
  sourceAsset StoredAsset?           @relation(fields: [sourceAssetId], references: [id], onDelete: SetNull)

  @@index([projectId, updatedAt])
  @@index([projectId, indexStatus])
}

model StoredAsset {
  id                  String             @id @default(cuid())
  ownerId             String
  projectId           String?
  objectKey           String             @unique
  purpose             StoredAssetPurpose
  status              StoredAssetStatus  @default(PENDING)
  originalName        String
  declaredMimeType    String
  detectedMimeType    String?
  expectedSizeBytes   Int
  checksumSha256      String
  sizeBytes           Int?
  etag                String?
  uploadExpiresAt     DateTime?
  validationStartedAt DateTime?
  readyAt             DateTime?
  restoreSessionId    String?
  restoreAttempt      Int?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  owner             User                       @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  project           Project?                   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messageAttachment MessageAttachment?
  sourceDocument    ProjectDocument?
  restoreSession    BinaryAssetRestoreSession? @relation(fields: [restoreSessionId, restoreAttempt], references: [id, attempt], onDelete: SetNull, map: "StoredAsset_restoreSessionId_fkey")

  @@index([ownerId, status])
  @@index([projectId, status])
  @@index([status, uploadExpiresAt])
  @@index([status, validationStartedAt])
  @@index([status, readyAt])
  @@index([restoreSessionId, restoreAttempt, status])
}

model BinaryAssetRestoreSession {
  id             String   @id
  ownerId        String
  attempt        Int      @default(1)
  attemptToken   String   @unique
  leaseExpiresAt DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner  User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  assets StoredAsset[]

  @@unique([id, attempt])
  @@index([ownerId])
  @@index([leaseExpiresAt])
}

model MessageAttachment {
  id        String @id @default(cuid())
  messageId String
  assetId   String @unique
  ordinal   Int

  message Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  asset   StoredAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([messageId, ordinal])
  @@index([messageId])
}

model ObjectDeletionJob {
  id            String   @id @default(cuid())
  objectKey     String   @unique
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([nextAttemptAt])
}

model ProjectDocumentChunk {
  id                  String                         @id @default(cuid())
  documentId          String
  chunkIndex          Int
  chunkCount          Int
  content             String
  contentHash         String
  embedding           Float[]                        @default([])
  embeddingModel      String?
  embeddingDimensions Int?
  embeddingStatus     ProjectDocumentEmbeddingStatus @default(PENDING)
  embeddingError      String?
  embeddedAt          DateTime?
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt

  document ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId, embeddingStatus])
}

model ProjectInstruction {
  projectId String   @id
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectMemory {
  projectId String       @id
  content   String
  source    MemorySource @default(USER_PROVIDED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AiUsageLog {
  id           String   @id @default(cuid())
  userId       String?
  chatId       String?
  messageId    String?
  provider     String
  model        String
  mode         String?
  status       String
  promptTokens Int?
  outputTokens Int?
  latencyMs    Int?
  costCents    Int?
  errorCode    String?
  createdAt    DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  chat    Chat?    @relation(fields: [chatId], references: [id], onDelete: SetNull)
  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([chatId, createdAt])
  @@index([provider, model])
  @@index([createdAt, id])
}

model UsageEvent {
  id                    String   @id @default(cuid())
  userId                String?
  guestId               String?
  ipHash                String?
  action                String
  units                 Int      @default(1)
  status                String   @default("reserved")
  provider              String?
  model                 String?
  mode                  String?
  workflowIntent        String?
  workflowSource        String?
  modelRoutingSource    String?
  creditsReserved       Int?
  creditsUsed           Int?
  estimatedPromptTokens Int?
  estimatedOutputTokens Int?
  estimatedTotalTokens  Int?
  promptTokens          Int?
  outputTokens          Int?
  totalTokens           Int?
  attachmentCount       Int      @default(0)
  imageCount            Int      @default(0)
  fileCount             Int      @default(0)
  providerAttempts      Int      @default(0)
  createdAt             DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, action, createdAt])
  @@index([guestId, action, createdAt])
  @@index([ipHash, action, createdAt])
  @@index([model, createdAt])
  @@index([action, createdAt])
  @@index([createdAt, id])
}
