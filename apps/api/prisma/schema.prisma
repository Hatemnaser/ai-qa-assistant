generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

enum MemoryScope {
  USER
  PROJECT
  CHAT
}

enum MemorySource {
  USER_PROVIDED
  AI_EXTRACTED
  CHAT_SUMMARY
  IMPORTED
}

enum ProjectDocumentSource {
  USER_PROVIDED
  IMPORTED
}

enum ProjectDocumentIndexStatus {
  PENDING
  READY
  FAILED
}

enum ProjectDocumentEmbeddingStatus {
  PENDING
  READY
  FAILED
}

enum StoredAssetPurpose {
  CHAT_ATTACHMENT
  PROJECT_DOCUMENT_SOURCE
  QA_EVIDENCE
}

enum StoredAssetStatus {
  PENDING
  VALIDATING
  READY
  FAILED
  DELETE_PENDING
}

enum AuthEmailKind {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum AuthEmailJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum QaRequestPhase {
  DRAFT
  GENERATING
  CHECKLIST_REVIEW
  READY_TO_RUN
  RUNNING
  EVIDENCE_NEEDED
  READY_FOR_REVIEW
  CHANGES_REQUESTED
  APPROVED
  PROCESSING_FAILED
  CANCELLED
}

enum QaArtifactOrigin {
  ODDPATH_GENERATED
  AGENT_PROVIDED
}

enum QaChecklistAssessmentStatus {
  PENDING
  PASSED
  SUGGESTIONS
  FAILED
}

enum QaRunStatus {
  CREATED
  ACTIVE
  RESULTS_SUBMITTED
  CANCELLED
}

enum QaRunOutcome {
  NOT_RUN
  PASS
  FAIL
  BLOCKED
  INCOMPLETE
}

enum QaCheckResultStatus {
  PASS
  FAIL
  BLOCKED
  SKIPPED
}

enum QaEvidenceKind {
  TEXT
  SCREENSHOT
  LOG
  TRACE
  FILE
  REFERENCE
}

enum QaReviewDecision {
  APPROVED
  CHANGES_REQUESTED
}

enum QaActorKind {
  USER
  INTEGRATION
  SYSTEM
}

enum QaTransport {
  WEB
  REST
  MCP
  SYSTEM
}

enum QaGenerationKind {
  CHECKLIST_GENERATION
  CHECKLIST_REVIEW
  EXECUTION_RECIPE_GENERATION
  EXECUTION_RECIPE_REVIEW
}

enum QaGenerationStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum QaExecutionJobStatus {
  QUEUED
  CLAIMED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ExternalIdempotencyState {
  PENDING
  COMPLETED
  LEGACY_AMBIGUOUS
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String?
  passwordHash         String?
  locale               String    @default("en")
  emailVerifiedAt      DateTime?
  acceptedTermsVersion String?
  acceptedTermsAt      DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  sessions                   Session[]
  settings                   UserSettings?
  ownedProjects              Project[]                   @relation("ProjectOwner")
  projectMemberships         ProjectMember[]
  chats                      Chat[]
  conversationSummaries      ConversationSummary[]
  memories                   Memory[]
  aiUsageLogs                AiUsageLog[]
  usageEvents                UsageEvent[]
  passwordResetTokens        PasswordResetToken[]
  emailVerificationTokens    EmailVerificationToken[]
  authEmailJobs              AuthEmailJob[]
  storedAssets               StoredAsset[]
  binaryAssetRestoreSessions BinaryAssetRestoreSession[]
  createdQaRequests          QaRequest[]                 @relation("QaRequestCreator")
  qaEvidence                 QaEvidence[]                @relation("QaEvidenceActor")
  qaHumanReviews             QaHumanReview[]             @relation("QaHumanReviewer")
  qaWorkflowEvents           QaWorkflowEvent[]           @relation("QaWorkflowEventActor")
  projectConnectionTokens    ProjectConnectionToken[]    @relation("ProjectConnectionTokenOwner")
  authoredQaExecutionRecipes QaExecutionRecipe[]         @relation("QaExecutionRecipeAuthor")
  qaExecutionAuthorizations  QaExecutionAuthorization[]  @relation("QaExecutionApprover")

  @@index([emailVerifiedAt, createdAt, id])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailJob AuthEmailJob?

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([usedAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailJob AuthEmailJob?

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([usedAt])
}

model AuthEmailJob {
  id                       String             @id
  userId                   String
  kind                     AuthEmailKind
  status                   AuthEmailJobStatus @default(PENDING)
  encryptedPayload         String?
  emailVerificationTokenId String?            @unique
  passwordResetTokenId     String?            @unique
  attempts                 Int                @default(0)
  nextAttemptAt            DateTime           @default(now())
  lockedAt                 DateTime?
  sentAt                   DateTime?
  expiresAt                DateTime
  lastErrorCode            String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailVerificationToken EmailVerificationToken? @relation(fields: [emailVerificationTokenId], references: [id], onDelete: Cascade)
  passwordResetToken     PasswordResetToken?     @relation(fields: [passwordResetTokenId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([status, expiresAt])
  @@index([status, updatedAt])
  @@index([userId, kind, status])
  @@index([lockedAt])
}

model UserSettings {
  id            String   @id @default(cuid())
  userId        String   @unique
  language      String   @default("en")
  theme         String   @default("system")
  defaultModel  String   @default("gemini-3.1-flash-lite")
  aiPreferences Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner                 User                     @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members               ProjectMember[]
  chats                 Chat[]
  memories              Memory[]
  documents             ProjectDocument[]
  instruction           ProjectInstruction?
  projectMemory         ProjectMemory?
  storedAssets          StoredAsset[]
  qaRequests            QaRequest[]
  connectionTokens      ProjectConnectionToken[]
  qaRunnerRegistrations QaRunnerRegistration[]
  qaExecutionJobs       QaExecutionJob[]

  @@index([ownerId])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Chat {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  title     String   @default("New QA Chat")
  mode      String   @default("general")
  model     String   @default("gemini-2.5-flash")
  kind      String   @default("CONVERSATION")
  nextTimelinePosition Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  project             Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages            Message[]
  conversationSummary ConversationSummary?
  memories            Memory[]
  aiUsageLogs         AiUsageLog[]
  testSession         TestSession?

  @@index([userId, updatedAt])
  @@index([projectId, updatedAt])
}

// Test conversation state is server-owned; generic chat snapshots cannot mutate it.
model TestSession {
  id               String    @id
  version          Int       @default(1)
  currentRequestId String?
  pendingProposal  Json?
  archivedAt       DateTime?
  chat             Chat      @relation(fields: [id], references: [id], onDelete: Cascade)
  requests         QaRequest[]
  turns            TestSessionTurn[]
  preparations     TestSessionPreparation[]
}

model TestSessionTurn {
  id             String    @id @default(cuid())
  sessionId      String
  clientTurnId   String
  inputHash      String
  messageId      String
  model          String?
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now())
  leaseToken     String?
  leaseExpiresAt DateTime?
  providerStartedAt DateTime?
  lastRetryKey   String?
  errorCode      String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
  session        TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, clientTurnId])
  @@index([status, availableAt, leaseExpiresAt])
}

model TestSessionPreparation {
  id                   String   @id @default(cuid())
  sessionId            String
  requestId            String   @unique
  proposalId           String
  status               String   @default("CHECKLIST")
  runnerRegistrationId String?
  profileKey           String?
  profileManifest      Json?
  recipeId             String?
  operationId          String?
  errorCode            String?
  attempt              Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  session              TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  request              QaRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([sessionId, proposalId])
  @@index([status, updatedAt])
}

model Message {
  id         String   @id @default(cuid())
  chatId     String
  role       ChatRole
  content    String
  mode       String   @default("general")
  model      String?
  attachment Json?
  metadata   Json?
  timelinePosition Int?
  createdAt  DateTime @default(now())

  chat        Chat                @relation(fields: [chatId], references: [id], onDelete: Cascade)
  aiUsageLogs AiUsageLog[]
  attachments MessageAttachment[]

  @@index([chatId, createdAt])
  @@index([chatId, timelinePosition])
}

model ConversationSummary {
  id               String   @id @default(cuid())
  chatId           String   @unique
  userId           String
  summary          String
  throughMessageId String?
  openQuestions    String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model Memory {
  id         String       @id @default(cuid())
  userId     String?
  projectId  String?
  chatId     String?
  scope      MemoryScope
  content    String
  source     MemorySource @default(USER_PROVIDED)
  confidence Float        @default(0.8)
  metadata   Json?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chat    Chat?    @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([userId, scope])
  @@index([projectId, scope])
  @@index([chatId, scope])
}

model ProjectDocument {
  id              String                     @id @default(cuid())
  projectId       String
  title           String
  content         String
  source          ProjectDocumentSource      @default(USER_PROVIDED)
  mimeType        String?
  metadata        Json?
  contentHash     String                     @default("")
  chunkingVersion String                     @default("")
  indexStatus     ProjectDocumentIndexStatus @default(PENDING)
  indexError      String?
  indexedAt       DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  sourceAssetId   String?                    @unique

  project     Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chunks      ProjectDocumentChunk[]
  sourceAsset StoredAsset?           @relation(fields: [sourceAssetId], references: [id], onDelete: SetNull)

  @@index([projectId, updatedAt])
  @@index([projectId, indexStatus])
}

model StoredAsset {
  id                  String             @id @default(cuid())
  ownerId             String
  projectId           String?
  objectKey           String             @unique
  purpose             StoredAssetPurpose
  status              StoredAssetStatus  @default(PENDING)
  originalName        String
  declaredMimeType    String
  detectedMimeType    String?
  expectedSizeBytes   Int
  checksumSha256      String
  sizeBytes           Int?
  etag                String?
  uploadExpiresAt     DateTime?
  validationStartedAt DateTime?
  readyAt             DateTime?
  restoreSessionId    String?
  restoreAttempt      Int?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  owner             User                       @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  project           Project?                   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messageAttachment MessageAttachment?
  sourceDocument    ProjectDocument?
  qaEvidenceAsset   QaEvidenceAsset?
  qaExecutionUpload QaExecutionEvidenceUpload?
  restoreSession    BinaryAssetRestoreSession? @relation(fields: [restoreSessionId, restoreAttempt], references: [id, attempt], onDelete: SetNull, map: "StoredAsset_restoreSessionId_fkey")

  @@index([ownerId, status])
  @@index([projectId, status])
  @@index([status, uploadExpiresAt])
  @@index([status, validationStartedAt])
  @@index([status, readyAt])
  @@index([restoreSessionId, restoreAttempt, status])
}

model BinaryAssetRestoreSession {
  id             String   @id
  ownerId        String
  attempt        Int      @default(1)
  attemptToken   String   @unique
  leaseExpiresAt DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner  User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  assets StoredAsset[]

  @@unique([id, attempt])
  @@index([ownerId])
  @@index([leaseExpiresAt])
}

model MessageAttachment {
  id        String @id @default(cuid())
  messageId String
  assetId   String @unique
  ordinal   Int

  message Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  asset   StoredAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([messageId, ordinal])
  @@index([messageId])
}

model ObjectDeletionJob {
  id            String   @id @default(cuid())
  objectKey     String   @unique
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([nextAttemptAt])
}

model ProjectDocumentChunk {
  id                  String                         @id @default(cuid())
  documentId          String
  chunkIndex          Int
  chunkCount          Int
  content             String
  contentHash         String
  embedding           Float[]                        @default([])
  embeddingModel      String?
  embeddingDimensions Int?
  embeddingStatus     ProjectDocumentEmbeddingStatus @default(PENDING)
  embeddingError      String?
  embeddedAt          DateTime?
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt

  document ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId, embeddingStatus])
}

model ProjectInstruction {
  projectId String   @id
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectMemory {
  projectId String       @id
  content   String
  source    MemorySource @default(USER_PROVIDED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AiUsageLog {
  id           String   @id @default(cuid())
  userId       String?
  chatId       String?
  messageId    String?
  provider     String
  model        String
  mode         String?
  status       String
  promptTokens Int?
  outputTokens Int?
  latencyMs    Int?
  costCents    Int?
  errorCode    String?
  createdAt    DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  chat    Chat?    @relation(fields: [chatId], references: [id], onDelete: SetNull)
  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([chatId, createdAt])
  @@index([provider, model])
  @@index([createdAt, id])
}

model UsageEvent {
  id                    String   @id @default(cuid())
  userId                String?
  guestId               String?
  ipHash                String?
  action                String
  units                 Int      @default(1)
  status                String   @default("reserved")
  provider              String?
  model                 String?
  mode                  String?
  workflowIntent        String?
  workflowSource        String?
  modelRoutingSource    String?
  creditsReserved       Int?
  creditsUsed           Int?
  estimatedPromptTokens Int?
  estimatedOutputTokens Int?
  estimatedTotalTokens  Int?
  promptTokens          Int?
  outputTokens          Int?
  totalTokens           Int?
  attachmentCount       Int      @default(0)
  imageCount            Int      @default(0)
  fileCount             Int      @default(0)
  providerAttempts      Int      @default(0)
  createdAt             DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, action, createdAt])
  @@index([guestId, action, createdAt])
  @@index([ipHash, action, createdAt])
  @@index([model, createdAt])
  @@index([action, createdAt])
  @@index([createdAt, id])
}

model QaRequest {
  id                 String         @id @default(cuid())
  projectId          String
  createdByUserId    String?
  title              String
  objective          String
  target             String?
  environment        String?
  acceptanceNotes    String?
  phase              QaRequestPhase @default(DRAFT)
  version            Int            @default(1)
  selectedArtifactId String?        @unique
  testSessionId      String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  project          Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy        User?                   @relation("QaRequestCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  selectedArtifact QaArtifact?             @relation("SelectedQaArtifact", fields: [selectedArtifactId], references: [id], onDelete: SetNull)
  contextSnapshots QaContextSnapshot[]
  artifacts        QaArtifact[]            @relation("QaRequestArtifacts")
  runs             QaRun[]
  reviews          QaHumanReview[]
  events           QaWorkflowEvent[]
  executions       QaGenerationExecution[]
  executionRecipes QaExecutionRecipe[]
  executionJobs    QaExecutionJob[]
  testSession      TestSession?            @relation(fields: [testSessionId], references: [id], onDelete: Restrict)
  preparation      TestSessionPreparation?

  @@index([projectId, phase, updatedAt, id])
  @@index([createdByUserId, createdAt])
  @@index([testSessionId, createdAt])
}

model QaContextSnapshot {
  id             String   @id @default(cuid())
  requestId      String
  version        Int
  schemaVersion  Int      @default(1)
  payload        Json
  sourceManifest Json
  payloadHash    String
  retrievalMode  String
  degraded       Boolean  @default(false)
  createdAt      DateTime @default(now())

  request   QaRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  artifacts QaArtifact[]

  @@unique([requestId, version])
  @@index([requestId, createdAt])
}

model QaArtifact {
  id               String           @id @default(cuid())
  requestId        String
  snapshotId       String
  revision         Int
  origin           QaArtifactOrigin
  schemaVersion    Int              @default(1)
  title            String
  canonicalJson    Json
  renderedMarkdown String?
  createdAt        DateTime         @default(now())
  lockedAt         DateTime?

  request                 QaRequest                  @relation("QaRequestArtifacts", fields: [requestId], references: [id], onDelete: Cascade)
  snapshot                QaContextSnapshot          @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  items                   QaChecklistItem[]
  assessments             QaChecklistAssessment[]
  runs                    QaRun[]
  reviews                 QaHumanReview[]
  selectedByRequest       QaRequest?                 @relation("SelectedQaArtifact")
  executionRecipes        QaExecutionRecipe[]
  executionAuthorizations QaExecutionAuthorization[]
  executionJobs           QaExecutionJob[]
  generationExecutions    QaGenerationExecution[]

  @@unique([requestId, revision])
  @@index([requestId, createdAt])
}

model QaChecklistItem {
  id             String   @id @default(cuid())
  artifactId     String
  ordinal        Int
  clientRef      String?
  title          String
  category       String?
  priority       String?
  preconditions  String[] @default([])
  steps          String[] @default([])
  expectedResult String
  createdAt      DateTime @default(now())

  artifact             QaArtifact                  @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  evidenceRequirements QaEvidenceRequirement[]
  results              QaCheckResult[]
  evidence             QaEvidence[]
  executionRecipeItems QaExecutionRecipeItem[]
  executionUploads     QaExecutionEvidenceUpload[]

  @@unique([artifactId, ordinal])
  @@unique([artifactId, clientRef])
  @@index([artifactId])
}

model QaChecklistAssessment {
  id          String                      @id @default(cuid())
  artifactId  String
  status      QaChecklistAssessmentStatus @default(PENDING)
  summary     String?
  suggestions Json
  provider    String?
  model       String?
  errorCode   String?
  createdAt   DateTime                    @default(now())
  completedAt DateTime?

  artifact QaArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([artifactId, createdAt])
}

model QaEvidenceRequirement {
  id              String         @id @default(cuid())
  checklistItemId String
  ordinal         Int
  kind            QaEvidenceKind
  description     String
  required        Boolean        @default(true)
  createdAt       DateTime       @default(now())

  checklistItem    QaChecklistItem             @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  evidence         QaEvidence[]
  executionUploads QaExecutionEvidenceUpload[]

  @@unique([checklistItemId, ordinal])
  @@index([checklistItemId])
}

model QaRun {
  id                String       @id @default(cuid())
  requestId         String
  artifactId        String
  executionRecipeId String?
  status            QaRunStatus  @default(CREATED)
  outcome           QaRunOutcome @default(NOT_RUN)
  version           Int          @default(1)
  sourceLabel       String?
  externalRunRef    String?
  commitSha         String?
  startedAt         DateTime?
  submittedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  request                QaRequest                 @relation(fields: [requestId], references: [id], onDelete: Cascade)
  artifact               QaArtifact                @relation(fields: [artifactId], references: [id], onDelete: Restrict)
  executionRecipe        QaExecutionRecipe?        @relation(fields: [executionRecipeId], references: [id], onDelete: SetNull)
  results                QaCheckResult[]
  evidence               QaEvidence[]
  reviews                QaHumanReview[]
  executionAuthorization QaExecutionAuthorization?
  executionJob           QaExecutionJob?

  @@unique([requestId, externalRunRef])
  @@index([requestId, createdAt, id])
  @@index([requestId, status])
  @@index([executionRecipeId])
}

model QaCheckResult {
  id              String              @id @default(cuid())
  runId           String
  checklistItemId String
  status          QaCheckResultStatus
  observedResult  String?
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  run           QaRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  checklistItem QaChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)

  @@unique([runId, checklistItemId])
  @@index([runId])
}

model QaEvidence {
  id                String         @id @default(cuid())
  runId             String
  checklistItemId   String?
  requirementId     String?
  createdByUserId   String?
  connectionTokenId String?
  actorKind         QaActorKind
  transport         QaTransport
  kind              QaEvidenceKind
  textContent       String?
  externalReference String?
  metadata          Json?
  createdAt         DateTime       @default(now())

  run             QaRun                   @relation(fields: [runId], references: [id], onDelete: Cascade)
  checklistItem   QaChecklistItem?        @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)
  requirement     QaEvidenceRequirement?  @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  createdBy       User?                   @relation("QaEvidenceActor", fields: [createdByUserId], references: [id], onDelete: SetNull)
  connectionToken ProjectConnectionToken? @relation(fields: [connectionTokenId], references: [id], onDelete: SetNull)
  assets          QaEvidenceAsset[]

  @@index([runId, createdAt])
  @@index([requirementId, createdAt])
}

model QaEvidenceAsset {
  id         String @id @default(cuid())
  evidenceId String
  assetId    String @unique
  ordinal    Int

  evidence QaEvidence  @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  asset    StoredAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([evidenceId, ordinal])
  @@index([evidenceId])
}

model QaHumanReview {
  id             String           @id @default(cuid())
  requestId      String
  runId          String
  artifactId     String
  reviewerUserId String?
  decision       QaReviewDecision
  comment        String?
  runVersion     Int
  createdAt      DateTime         @default(now())

  request  QaRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  run      QaRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  artifact QaArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  reviewer User?      @relation("QaHumanReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@index([runId, createdAt])
}

model QaWorkflowEvent {
  id                String      @id @default(cuid())
  requestId         String
  sequence          Int
  timelinePosition  Int?
  type              String
  actorKind         QaActorKind
  actorUserId       String?
  connectionTokenId String?
  transport         QaTransport
  metadata          Json?
  createdAt         DateTime    @default(now())

  request         QaRequest               @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor           User?                   @relation("QaWorkflowEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  connectionToken ProjectConnectionToken? @relation(fields: [connectionTokenId], references: [id], onDelete: SetNull)

  @@unique([requestId, sequence])
  @@index([requestId, createdAt])
}

model QaGenerationExecution {
  id                  String             @id @default(cuid())
  requestId           String
  artifactId          String?
  recipeId            String?
  kind                QaGenerationKind
  status              QaGenerationStatus @default(PENDING)
  idempotencyKeyHash  String?
  provider            String?
  model               String?
  profileManifest     Json?
  profileManifestHash String?
  attempts            Int                @default(0)
  availableAt         DateTime           @default(now())
  leaseToken          String?
  leaseExpiresAt      DateTime?
  errorCode           String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  completedAt         DateTime?

  request  QaRequest          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  artifact QaArtifact?        @relation(fields: [artifactId], references: [id], onDelete: SetNull)
  recipe   QaExecutionRecipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@unique([requestId, kind, idempotencyKeyHash])
  @@index([status, availableAt, leaseExpiresAt])
  @@index([requestId, createdAt])
  @@index([artifactId])
  @@index([recipeId])
}

model QaExecutionRecipe {
  id                  String           @id @default(cuid())
  requestId           String
  artifactId          String
  revision            Int
  origin              QaArtifactOrigin
  schemaVersion       Int              @default(1)
  executorKey         String
  title               String
  canonicalJson       Json
  recipeHash          String
  profileManifest     Json?
  profileManifestHash String?
  supersedesRecipeId  String?
  createdByUserId     String?
  connectionTokenId   String?
  transport           QaTransport
  provider            String?
  model               String?
  lockedAt            DateTime?
  createdAt           DateTime         @default(now())

  request         QaRequest                     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  artifact        QaArtifact                    @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  createdBy       User?                         @relation("QaExecutionRecipeAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)
  connectionToken ProjectConnectionToken?       @relation(fields: [connectionTokenId], references: [id], onDelete: SetNull)
  supersedes      QaExecutionRecipe?            @relation("QaExecutionRecipeSupersession", fields: [supersedesRecipeId], references: [id], onDelete: SetNull)
  supersededBy    QaExecutionRecipe[]           @relation("QaExecutionRecipeSupersession")
  items           QaExecutionRecipeItem[]
  assessments     QaExecutionRecipeAssessment[]
  runs            QaRun[]
  authorizations  QaExecutionAuthorization[]
  jobs            QaExecutionJob[]
  executions      QaGenerationExecution[]

  @@unique([artifactId, revision])
  @@unique([artifactId, recipeHash, profileManifestHash], map: "QaExecutionRecipe_artifact_recipe_profile_key")
  @@index([requestId, createdAt])
  @@index([artifactId, createdAt])
  @@index([createdByUserId])
  @@index([connectionTokenId])
  @@index([supersedesRecipeId])
}

model QaExecutionRecipeItem {
  id              String @id @default(cuid())
  recipeId        String
  checklistItemId String
  ordinal         Int
  steps           Json
  recipeHash      String

  recipe        QaExecutionRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  checklistItem QaChecklistItem   @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)

  @@unique([recipeId, ordinal])
  @@unique([recipeId, checklistItemId])
  @@index([checklistItemId])
}

model QaExecutionRecipeAssessment {
  id          String                      @id @default(cuid())
  recipeId    String
  status      QaChecklistAssessmentStatus @default(PENDING)
  summary     String?
  suggestions Json
  provider    String?
  model       String?
  errorCode   String?
  createdAt   DateTime                    @default(now())
  completedAt DateTime?

  recipe QaExecutionRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId, createdAt])
}

model QaRunnerRegistration {
  id                String   @id @default(cuid())
  projectId         String
  connectionTokenId String
  instanceId        String
  displayName       String
  runnerVersion     String
  protocolVersions  Int[]    @default([])
  executorKeys      String[] @default([])
  publicProfiles    Json
  lastSeenAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project         Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connectionToken ProjectConnectionToken     @relation(fields: [connectionTokenId], references: [id], onDelete: Cascade)
  authorizations  QaExecutionAuthorization[]
  jobs            QaExecutionJob[]

  @@unique([connectionTokenId, instanceId])
  @@index([projectId, lastSeenAt])
  @@index([connectionTokenId, lastSeenAt])
}

model QaExecutionAuthorization {
  id                   String   @id @default(cuid())
  runId                String   @unique
  recipeId             String
  artifactId           String
  approvedByUserId     String?
  runnerRegistrationId String?
  recipeHash           String
  profileKey           String
  profileManifestHash  String
  productionConfirmed  Boolean  @default(false)
  approvedAt           DateTime @default(now())

  run                QaRun                 @relation(fields: [runId], references: [id], onDelete: Cascade)
  recipe             QaExecutionRecipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  artifact           QaArtifact            @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  approvedBy         User?                 @relation("QaExecutionApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  runnerRegistration QaRunnerRegistration? @relation(fields: [runnerRegistrationId], references: [id], onDelete: SetNull)
  job                QaExecutionJob?

  @@index([recipeId, approvedAt])
  @@index([runnerRegistrationId, approvedAt])
  @@index([artifactId])
  @@index([approvedByUserId])
}

model QaExecutionJob {
  id                   String               @id @default(cuid())
  projectId            String
  requestId            String
  runId                String               @unique
  artifactId           String
  recipeId             String
  authorizationId      String               @unique
  runnerRegistrationId String
  protocolVersion      Int                  @default(1)
  executorKey          String
  profileKey           String
  profileManifestHash  String
  recipeHash           String
  status               QaExecutionJobStatus @default(QUEUED)
  attempts             Int                  @default(0)
  availableAt          DateTime             @default(now())
  deadlineAt           DateTime
  claimId              String?
  runnerInstanceId     String?
  leaseTokenHash       String?
  leaseExpiresAt       DateTime?
  lastHeartbeatAt      DateTime?
  acceptedAt           DateTime?
  errorCode            String?
  errorMessage         String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  completedAt          DateTime?

  project            Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  request            QaRequest                   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  run                QaRun                       @relation(fields: [runId], references: [id], onDelete: Cascade)
  artifact           QaArtifact                  @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  recipe             QaExecutionRecipe           @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  authorization      QaExecutionAuthorization    @relation(fields: [authorizationId], references: [id], onDelete: Cascade)
  runnerRegistration QaRunnerRegistration        @relation(fields: [runnerRegistrationId], references: [id], onDelete: Cascade)
  uploads            QaExecutionEvidenceUpload[]

  @@index([status, availableAt, leaseExpiresAt])
  @@index([runnerRegistrationId, status, availableAt])
  @@index([requestId, createdAt])
  @@index([projectId])
  @@index([artifactId])
  @@index([recipeId])
}

model QaExecutionEvidenceUpload {
  id              String    @id @default(cuid())
  executionJobId  String
  checklistItemId String
  requirementId   String
  assetId         String    @unique
  createdAt       DateTime  @default(now())
  consumedAt      DateTime?

  executionJob  QaExecutionJob        @relation(fields: [executionJobId], references: [id], onDelete: Cascade)
  checklistItem QaChecklistItem       @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  requirement   QaEvidenceRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  asset         StoredAsset           @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([executionJobId, consumedAt])
  @@index([requirementId])
  @@index([checklistItemId])
}

model ProjectConnectionToken {
  id          String    @id @default(cuid())
  projectId   String
  ownerId     String
  name        String
  tokenPrefix String
  tokenHash   String    @unique
  scopes      String[]  @default([])
  expiresAt   DateTime?
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project             Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner               User                        @relation("ProjectConnectionTokenOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  evidence            QaEvidence[]
  events              QaWorkflowEvent[]
  idempotencyRecords  ExternalIdempotencyRecord[]
  executionRecipes    QaExecutionRecipe[]
  runnerRegistrations QaRunnerRegistration[]

  @@index([projectId, revokedAt])
  @@index([ownerId, createdAt])
  @@index([tokenPrefix])
}

model ExternalIdempotencyRecord {
  id              String                   @id @default(cuid())
  credentialId    String
  operation       String
  keyHash         String
  requestHash     String
  responseStatus  Int?
  responseBody    Json?
  resourceId      String?
  resourceType    String?
  state           ExternalIdempotencyState @default(PENDING)
  protocolVersion Int                      @default(2)
  completedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  credential ProjectConnectionToken @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@unique([credentialId, operation, keyHash])
  @@index([credentialId, createdAt])
  @@index([state, expiresAt])
}
