PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
APP_ORIGIN=http://127.0.0.1:5173
TRUST_PROXY_HOPS=0
# Positive integer in b/kb/mb; hard-capped at 25mb.
REQUEST_BODY_LIMIT=25mb
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_qa_assistant?schema=public

# Auth links and tokens
PASSWORD_RESET_PATH=/#/reset-password
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_PATH=/#/verify-email
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60

# Registration defaults to public only in development/test and fail-closes to disabled in production.
# For a private beta, set invite and provide comma-separated SHA-256 hashes of high-entropy codes.
REGISTRATION_MODE=public
REGISTRATION_INVITE_CODE_HASHES=
CURRENT_TERMS_VERSION=development-v1
# Operator acknowledgement only. Never set true while legal pages are drafts/placeholders.
LEGAL_DOCUMENTS_PUBLISHED_CONFIRMED=false

# Email
# Leave EMAIL_PROVIDER empty for local in-memory email capture. Use noop only intentionally outside production.
EMAIL_PROVIDER=
EMAIL_FROM="Oddpath <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# false uses mandatory STARTTLS; true uses implicit TLS (normally port 465).
SMTP_SECURE=false
EMAIL_OUTBOX_ENCRYPTION_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
EMAIL_OUTBOX_POLL_INTERVAL_MS=5000
EMAIL_OUTBOX_BATCH_SIZE=10
EMAIL_OUTBOX_MAX_ATTEMPTS=5
AUTH_EMAIL_RESPONSE_FLOOR_MS=350

AI_PROVIDER=gemini
AI_ENABLED=true
GUEST_AI_ENABLED=true
GEMINI_API_KEY=your_gemini_api_key_here
# This is an operator acknowledgement, not an automated billing check.
# Production AI cannot boot until the key belongs to a paid project and this is true.
GEMINI_PAID_SERVICE_CONFIRMED=false
GEMINI_MODEL=gemini-3.1-flash-lite
AI_WORKFLOW_ROUTER_ENABLED=true
AI_WORKFLOW_ROUTER_MODEL=gemini-3.1-flash-lite
AI_WORKFLOW_ROUTER_MIN_CONFIDENCE=0.72
AI_WORKFLOW_ROUTER_TIMEOUT_MS=8000
AI_SUMMARY_MODEL=gemini-3.1-flash-lite
AI_SUMMARY_TIMEOUT_MS=15000
AI_MODEL_ROUTER_ENABLED=true
AI_GENERAL_MODEL=gemini-3.1-flash-lite
AI_VISUAL_MODEL=gemini-2.5-flash
AI_FALLBACK_MODEL=gemini-2.5-flash-lite
AI_TIMEOUT_MS=55000
AI_MAX_OUTPUT_TOKENS=2048
AI_GLOBAL_USAGE_WINDOW_MS=3600000
AI_GLOBAL_REQUEST_LIMIT=1000
AI_GLOBAL_CREDIT_LIMIT=5000
AI_GLOBAL_DAILY_REQUEST_LIMIT=2500
AI_GLOBAL_DAILY_CREDIT_LIMIT=10000
AI_GLOBAL_MONTHLY_REQUEST_LIMIT=30000
AI_GLOBAL_MONTHLY_CREDIT_LIMIT=100000
PROJECT_DOCUMENT_EMBEDDINGS_ENABLED=false
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
EMBEDDING_TIMEOUT_MS=15000

GUEST_DAILY_CREDITS=20
USER_DAILY_CREDITS=100
USAGE_TOKENS_PER_CREDIT=1000
USAGE_IMAGE_CREDITS=4
USAGE_TEXT_FILE_CREDITS=1
USAGE_ROUTER_CREDITS=1
USAGE_WINDOW_HOURS=24
USAGE_STALE_RESERVED_MINUTES=30
MAX_MESSAGE_CHARS=3000
MAX_HISTORY_MESSAGES=10
MAX_HISTORY_TOTAL_CHARS=20000
USAGE_IP_HASH_SALT=change_this_for_production

# Cookies
# Use lax for same-site deployments. Use none + secure=true when web/API are on different HTTPS sites.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
COOKIE_DOMAIN=
CSRF_COOKIE_NAME=qa_csrf
CSRF_HEADER_NAME=X-CSRF-Token
CSRF_SECRET=development-csrf-secret-change-before-production

# Single-process baseline. Multi-instance production needs a shared limiter.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_REGISTER_RATE_LIMIT_MAX=5
AUTH_FORGOT_PASSWORD_RATE_LIMIT_MAX=5
AUTH_RESET_PASSWORD_RATE_LIMIT_MAX=5
AUTH_RESEND_VERIFICATION_RATE_LIMIT_MAX=5
AUTH_VERIFY_EMAIL_RATE_LIMIT_MAX=20
ACCOUNT_DELETE_RATE_LIMIT_MAX=5
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=60
GUEST_CHAT_RATE_LIMIT_MAX=30
CHAT_IN_FLIGHT_GLOBAL_MAX=4
CHAT_IN_FLIGHT_PER_IP_MAX=2

# Synchronous ZIP import is fail-closed in production. Enable only after
# staging validation of the documented size/rate/concurrency boundaries.
PORTABILITY_IMPORTS_ENABLED=true

# Private Cloudflare R2 assets. Archive v2 export/restore is implemented, but
# production startup still rejects true until the guarded real-PostgreSQL and
# EU R2 interruption/cleanup gates are recorded. Staging may enable it only for
# the documented end-to-end validation matrix.
PRIVATE_ASSETS_ENABLED=false
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Opt-in operator-only EU R2 mutation smoke; never enable in a long-lived
# application environment. See docs/R2_SMOKE_RUNBOOK.md.
ODDPATH_R2_SMOKE_CORS_ORIGIN=
ODDPATH_R2_SMOKE_CONFIRMATION=
ODDPATH_R2_SMOKE_TIMEOUT_MS=15000
ASSET_UPLOAD_URL_TTL_SECONDS=600
ASSET_DOWNLOAD_URL_TTL_SECONDS=300
ASSET_MAX_IMAGE_BYTES=4194304
ASSET_MAX_TEXT_BYTES=1048576
ASSET_USER_QUOTA_BYTES=52428800
ASSET_MAX_PENDING_PER_USER=4
ASSET_CLEANUP_BATCH_SIZE=100
ASSET_INITIATE_RATE_LIMIT_WINDOW_MS=60000
ASSET_INITIATE_RATE_LIMIT_MAX=20

# Scheduled privacy cleanup (run at least daily from one trusted job runner).
AUTH_TOKEN_RETENTION_DAYS=7
# Unverified accounts older than this are deleted only when they have no session.
UNVERIFIED_ACCOUNT_RETENTION_DAYS=7
USAGE_RECORD_RETENTION_DAYS=32
RETENTION_CLEANUP_BATCH_SIZE=100
