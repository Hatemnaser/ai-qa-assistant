{
  "name": "@ai-qa-assistant/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "test:integration:db": "tsx --test --test-timeout=30000 tests/postgres.integration.ts",
    "build": "prisma generate --no-hints && tsc -p tsconfig.json",
    "check": "npm run check:architecture && prisma generate --no-hints && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "check:architecture": "node scripts/check-architecture-boundaries.mjs",
    "cleanup:retention": "node dist/scripts/cleanup-retention.js",
    "cleanup:retention:dev": "tsx src/scripts/cleanup-retention.ts",
    "smoke:read-only": "node dist/scripts/smoke-target.js --mode=read-only",
    "smoke:read-only:dev": "tsx src/scripts/smoke-target.ts --mode=read-only",
    "smoke:authenticated-mutation": "node dist/scripts/smoke-target.js --mode=authenticated-mutation",
    "smoke:authenticated-mutation:dev": "tsx src/scripts/smoke-target.ts --mode=authenticated-mutation",
    "smoke:r2": "node dist/scripts/smoke-r2.js --mode=eu-r2-mutation",
    "smoke:r2:dev": "tsx src/scripts/smoke-r2.ts --mode=eu-r2-mutation",
    "eval:retrieval": "tsx scripts/evaluate-project-document-retrieval.ts",
    "assets:cleanup": "node dist/scripts/cleanup-assets.js",
    "assets:cleanup:dev": "tsx src/scripts/cleanup-assets.ts",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:drift:check": "prisma migrate status && prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1108.0",
    "@aws-sdk/s3-request-presigner": "3.1108.0",
    "@google/genai": "^1.50.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "nodemailer": "^9.0.1",
    "pg": "^8.20.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.16.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
