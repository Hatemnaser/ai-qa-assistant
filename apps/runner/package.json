{
  "name": "@oddpath/runner",
  "version": "0.1.0",
  "description": "Local Oddpath Playwright execution runner",
  "type": "module",
  "bin": {
    "oddpath": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm --prefix ../../packages/qa-execution-contract run build && tsc -p tsconfig.json",
    "check": "npm --prefix ../../packages/qa-execution-contract run build && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@oddpath/qa-execution-contract": "0.1.0",
    "playwright": "1.62.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.22.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "license": "UNLICENSED"
}
